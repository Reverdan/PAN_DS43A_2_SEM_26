<Window x:Class="CRUDPessoas.apresentacao.frmCadastrar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastrar" 
        Height="529" Width="450"
        Background="#121212" 
        FontFamily="Segoe UI" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Estilo para Labels (TextBlock) -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Estilo para TextBox com bordas arredondadas -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Background" Value="#2D2D30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Button com bordas arredondadas -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C8CED"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Container principal com efeito de "Card" -->
    <Border Background="#1E1E1E" CornerRadius="12" Margin="20" BorderBrush="#2D2D30" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título do Formulário -->
            <TextBlock Grid.Row="0" 
                       Text="Cadastrar" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF" 
                       Margin="0,0,0,25"/>

            <!-- Campos do Formulário -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">

                <TextBlock Text="Nome Completo" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txbNome" Style="{StaticResource ModernTextBox}" Margin="0,0,0,18"/>

                <TextBlock Text="RG" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txbRg" Style="{StaticResource ModernTextBox}" Margin="0,0,0,18"/>

                <TextBlock Text="CPF" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txbCpf" Style="{StaticResource ModernTextBox}" Margin="0,0,0,0"/>

            </StackPanel>

            <!-- Botão de Ação -->
            <Button x:Name="btnCadastrar"
                Grid.Row="2" 
                    Content="Cadastrar" 
                    Style="{StaticResource ModernButton}" 
                    Margin="0,25,0,0" Click="btnCadastrar_Click"/>
        </Grid>
    </Border>
</Window>
