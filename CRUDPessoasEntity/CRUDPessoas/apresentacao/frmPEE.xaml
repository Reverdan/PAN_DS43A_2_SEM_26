<Window x:Class="CRUDPessoas.apresentacao.frmPEE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUDPessoas.apresentacao"
        mc:Ignorable="d"
        Title="Pesquisar / Editar / Excluir"
        Height="520"
        Width="800"
        Background="#121212"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- Label -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#0078D4"/>
                            </Trigger>

                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#0078D4"/>
                                <Setter Property="Background"
                                        Value="#2D2D30"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="#1C8CED"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"
                            Value="#005A9E"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- Botão Excluir -->
        <Style x:Key="DeleteButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">

            <Setter Property="Background" Value="#C42B2B"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="#E03A3A"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"
                            Value="#8F1F1F"/>
                </Trigger>

            </Style.Triggers>
        </Style>

    </Window.Resources>


    <!-- CARD -->
    <Border Background="#1E1E1E"
            CornerRadius="12"
            Margin="20"
            BorderBrush="#2D2D30"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                ShadowDepth="0"
                Color="Black"
                Opacity="0.4"/>
        </Border.Effect>


        <Grid Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- TÍTULO -->
            <TextBlock Grid.Row="0"
                       Text="Pesquisar, Editar e Excluir"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       Margin="0,0,0,25"/>


            <!-- CAMPOS -->
            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ID -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="ID"
                               Style="{StaticResource ModernLabel}"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txbId"
                             Grid.Column="1"
                             Height="42"
                             Style="{StaticResource ModernTextBox}"/>

                    <Button x:Name="btnPesquisarId"
                            Grid.Column="2"
                            Content="Pesquisar"
                            Height="42"
                            Margin="12,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Click="btnPesquisarId_Click"/>

                </Grid>


                <!-- NOME -->
                <Grid Grid.Row="1"
                      Margin="0,0,0,18">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="Nome"
                               Style="{StaticResource ModernLabel}"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txbNome"
                             Grid.Column="1"
                             Height="42"
                             Style="{StaticResource ModernTextBox}"/>

                    <Button x:Name="btnPesquisarNome"
                            Grid.Column="2"
                            Content="Pesquisar"
                            Height="42"
                            Margin="12,0,0,0"
                            Style="{StaticResource ModernButton}"
                            Click="btnPesquisarNome_Click"/>

                </Grid>


                <!-- RG + CPF -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <!-- RG -->
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="180"/>

                        <!-- Espaço -->
                        <ColumnDefinition Width="40"/>

                        <!-- CPF -->
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- RG -->
                    <TextBlock Grid.Column="0"
                               Text="RG"
                               Style="{StaticResource ModernLabel}"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txbRg"
                             Grid.Column="1"
                             Height="42"
                             Style="{StaticResource ModernTextBox}"/>


                    <!-- CPF -->
                    <TextBlock Grid.Column="3"
                               Text="CPF"
                               Style="{StaticResource ModernLabel}"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txbCpf"
                             Grid.Column="4"
                             Height="42"
                             Style="{StaticResource ModernTextBox}" HorizontalAlignment="Left" Width="197"/>

                </Grid>

            </Grid>


            <!-- BOTÕES -->
            <Grid Grid.Row="2"
                  Margin="0,25,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- EXCLUIR - TOTALMENTE À ESQUERDA -->
                <Button x:Name="btnExcluir"
                        Grid.Column="0"
                        Content="Excluir"
                        Width="120"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DeleteButton}"
                        Click="btnExcluir_Click"/>


                <!-- EDITAR - TOTALMENTE À DIREITA -->
                <Button x:Name="btnEditar"
                        Grid.Column="1"
                        Content="Editar"
                        Width="120"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ModernButton}"
                        Click="btnEditar_Click"/>

            </Grid>

        </Grid>

    </Border>

</Window>